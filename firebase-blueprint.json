{
  "entities": {
    "User": {
      "title": "User",
      "description": "A user profile in the system.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "The Firebase Auth UID of the user."
        },
        "name": {
          "type": "string",
          "description": "The user's display name."
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "The user's email address."
        },
        "avatar": {
          "type": "string",
          "description": "URL to the user's avatar image."
        },
        "generationsUsed": {
          "type": "number",
          "description": "Number of voice generations the user has used."
        },
        "plan": {
          "type": "string",
          "enum": ["free", "pro"],
          "description": "The user's subscription plan."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "When the user profile was created."
        }
      },
      "required": ["uid", "name", "email", "generationsUsed", "plan", "createdAt"]
    },
    "Generation": {
      "title": "Generation",
      "description": "A voiceover generated by a user.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "The UID of the user who generated this."
        },
        "date": {
          "type": "string",
          "format": "date-time",
          "description": "When the generation was created."
        },
        "script": {
          "type": "string",
          "description": "The text script used for the generation."
        },
        "audioUrl": {
          "type": "string",
          "description": "The base64 audio data or URL."
        },
        "voice": {
          "type": "string",
          "description": "The voice used for the generation."
        }
      },
      "required": ["userId", "date", "script", "audioUrl", "voice"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": {
        "$ref": "#/entities/User"
      },
      "description": "Stores user profiles."
    },
    "/generations/{generationId}": {
      "schema": {
        "$ref": "#/entities/Generation"
      },
      "description": "Stores voiceover generations."
    }
  }
}
